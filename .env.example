# Mesma origem: browser fala /api no front; Nitro/Vite encaminha ao Laravel.
NUXT_PUBLIC_SITE_URL=http://localhost:3002
NUXT_PUBLIC_API_BASE=/api
NUXT_PROXY_API_TARGET=http://localhost:8082

