# Dev com proxy Nuxt (recomendado): mesma origem localhost:3002, sem CORS/CSRF entre portas
NUXT_PUBLIC_SITE_URL=http://localhost:3002
NUXT_PUBLIC_API_BASE=/api
NUXT_PROXY_API_TARGET=http://localhost:8082

# Alternativa sem proxy (cross-origin — exige CORS + header CSRF manual):
# NUXT_PUBLIC_API_BASE=http://localhost:8082/api
